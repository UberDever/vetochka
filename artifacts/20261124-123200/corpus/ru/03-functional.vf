# функциональный стиль: лямбды и связыватели берут одно выражение, без блоков
квадраты = отобразить(числа, \[х] х * х)
чётные = отобрать(числа, \[х] х % 2 == 0)
сумма = свернуть(числа, 0, \[итог, х] итог + х)

композиция = \[ф, г] \[х] ф(г(х))
плюс_один = \[х] х + 1
дважды = \[ф] композиция(ф, ф)

среднее = \[числа] =[всего = свернуть(числа, 0, \[а, б] а + б), количество = длина(числа)] всего / количество

конвейер = =[разобранные = отобразить(строки, разобрать_число),
             годные = отобрать(разобранные, \[ч] ч >= 0),
             умноженные = отобразить(годные, \[ч] ч * 10)] свернуть(умноженные, 0, \[а, б] а + б)
