# проверка глубокой вложенности
транзакция(бд) |
    для_каждой(записи) каждая: \[запись] |
        если(годна(запись)) |
            с_блокировкой(мьютекс) |
                повторить(3) |
                    если(существует(запись)) |
                        обновить(запись)
                    ;; иначе: |
                        вставить(запись)
                    ;;
                ;;
            ;;
        ;;
    ;;
;;
