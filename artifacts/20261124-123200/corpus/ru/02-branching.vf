# условия с помеченными альтернативами, циклы с досрочным выходом
функция классифицировать: [ч :: цел32] результат: строка |
    если(ч < 0) |
        {отрицательное}
    ;; иначе_если: (ч == 0) |
        {ноль}
    ;; иначе_если: (ч < 10) |
        {малое}
    ;; иначе: |
        {большое}
    ;;
;;

функция найти_первый: [элементы :: срез(цел32), цель :: цел32] результат: цел_разм |
    и := 0
    пока(и < длина(элементы)) |
        если(элементы[и] == цель) |
            вернуть(и)
        ;;
        если(элементы[и] < 0) |
            и += 1
            продолжить()
        ;;
        и += 1
    ;;
    -1
;;

функция знак: [х :: цел32] результат: цел32 |
    если(х > 0) | 1 ;; иначе: | -1 ;;
;;
