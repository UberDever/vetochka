# vsystem: размеченные объединения и сопоставление
объединение Фигура: [] |
    круг: [радиус :: вещ64]
    прямоугольник: [ширина :: вещ64, высота :: вещ64]
    пусто: []
;;

функция площадь: [фигура :: Фигура] результат: вещ64 |
    разобрать(фигура) |
        случай круг: [р] |
            вещ64{3.14159} * р * р
        ;;
        случай прямоугольник: [ш, в] |
            ш * в
        ;;
        случай пусто: [] |
            вещ64{0}
        ;;
    ;;
;;

функция описать: [фигура :: Фигура] результат: строка |
    разобрать(фигура) |
        случай круг: [р] | формат({круг радиуса {}}, р) ;;
        случай прямоугольник: [ш, в] | формат({прямоугольник {} на {}}, ш, в) ;;
        случай пусто: [] | {ничего} ;;
    ;;
;;
