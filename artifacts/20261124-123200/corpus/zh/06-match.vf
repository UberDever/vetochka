# vsystem：带标签的联合与模式匹配
联合 形状: [] |
    圆: [半径 :: 浮64]
    矩形: [宽 :: 浮64, 高 :: 浮64]
    空: []
;;

函数 面积: [形 :: 形状] 结果: 浮64 |
    匹配(形) |
        情况 圆: [半] |
            浮64{3.14159} * 半 * 半
        ;;
        情况 矩形: [宽, 高] |
            宽 * 高
        ;;
        情况 空: [] |
            浮64{0}
        ;;
    ;;
;;

函数 描述: [形 :: 形状] 结果: 字串 |
    匹配(形) |
        情况 圆: [半] | 格式({半径为 {} 的圆}, 半) ;;
        情况 矩形: [宽, 高] | 格式({{} 乘 {} 的矩形}, 宽, 高) ;;
        情况 空: [] | {无} ;;
    ;;
;;
