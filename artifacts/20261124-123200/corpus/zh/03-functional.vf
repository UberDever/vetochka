# 函数式风格：lambda 与绑定只取一个表达式，不用块
平方 = 映射(列, \[元] 元 * 元)
偶数 = 过滤(列, \[元] 元 % 2 == 0)
总和 = 折叠(列, 0, \[累计, 元] 累计 + 元)

组合 = \[函, 另] \[元] 函(另(元))
加一 = \[元] 元 + 1
两次 = \[函] 组合(函, 函)

平均 = \[列] =[和 = 折叠(列, 0, \[甲, 乙] 甲 + 乙), 个数 = 长度(列)] 和 / 个数

流水线 = =[已解析 = 映射(各行, 解析整数),
           有效 = 过滤(已解析, \[数] 数 >= 0),
           放大 = 映射(有效, \[数] 数 * 10)] 折叠(放大, 0, \[甲, 乙] 甲 + 乙)
