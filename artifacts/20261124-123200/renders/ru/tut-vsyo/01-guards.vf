;; vsystem: растущий вектор; проверки с ранним возвратом
функция зарезервировать: [Т, в :: указ(Вектор(Т)), нужно :: разм] результат: лог тут
    если(нужно <= в[.ёмкость]) тут
        вернуть(истина)
    всё
    новая_ёмкость := макс(нужно, макс(в[.ёмкость] * 2, 8))
    новые_данные := пам[.выделить_массив](в[.распределитель], Т, новая_ёмкость)
    если(новые_данные == пусто) тут
        вернуть(ложь)
    всё
    если(в[.данные] != пусто) тут
        пам[.копировать](новые_данные, в[.данные], в[.длина])
        пам[.освободить](в[.распределитель], в[.данные])
    всё
    в[.данные] = новые_данные
    в[.ёмкость] = новая_ёмкость
    истина
всё

функция добавить: [Т, в :: указ(Вектор(Т)), значение :: Т] результат: лог тут
    если(в[.длина] == в[.ёмкость]) тут
        если(!зарезервировать(Т, в, в[.длина] + 1)) тут
            вернуть(ложь)
        всё
    всё
    в[.данные][в[.длина]] = значение
    в[.длина] += 1
    истина
всё
