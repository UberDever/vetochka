;; обратные вызовы: блоки внутри вызовов заканчиваются на `;;)`
функция собрать_большие: [числа :: список(цел32)] результат: список(цел32) тут
    итог := []
    для_каждого(числа, \[х] тут
        если(х > 10) тут
            дописать(итог, х)
        всё
    всё)
    итог
всё

при(кнопка, {нажатие}, \[событие] тут
    записать({нажато в}, событие[.х], событие[.у])
    обновить(вид)
всё)

с_повтором(3, \[попытка] тут
    подключиться(сервер) при_ошибке: \[ошибка] тут
        записать({попытка не удалась}, попытка, ошибка)
    всё
всё)

таймер = каждые(секунды(5), \[тик] тут опросить(очередь) всё)
