;; параллелизм: акторы и циклы сообщений
счётчик = запустить тут
    счёт := 0
    цикл тут
        принять(сообщение) тут
            случай увеличить: [] тут счёт += 1 всё
            случай получить: [ответить] тут
                отправить(ответить, счёт)
            всё
            случай стоп: [] тут
                прервать()
            всё
        всё
    всё
всё

параллельно(задачи) каждая: \[задача] тут
    итог := выполнить(задача)
    отправить(сборщик, итог)
всё
