;; vmeta: проходы — это функции над термами
имена = \[сам, ~[голова, хвост], собранное]
    ?[{:all}, {:fork}, {:all}] сам(сам, хвост, сам(сам, голова, собранное))
    ?[{:all}, {:fruit}, {:all}] собранное
    ?[{:all}, {:leaf}, {:all}] собранное

проход имя: собрать_имена_функций над: модуль тут
    найдено := []
    обойти(модуль) для: \[узел] тут
        если(это_функция(узел)) тут
            добавить(найдено, узел[.имя])
        всё
    всё
    найдено
всё

проход имя: запретить_malloc над: модуль тут
    обойти(модуль) для: \[узел] тут
        если(это_вызов(узел, {malloc})) тут
            сообщить(узел, {используйте параметр-распределитель})
        всё
    всё
всё
