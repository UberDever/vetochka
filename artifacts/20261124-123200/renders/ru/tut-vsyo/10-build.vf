;; описание сборки: декларативная вложенность
сборка тут
    цель имя: {приложение} вид: {исполняемый} тут
        исходники: [{src/main.vf}, {src/net.vf}]
        оптимизация: {выпуск}
        зависит: [{ядро}, {сеть}]
    всё
    цель имя: {ядро} вид: {библиотека} тут
        исходники: шаблон({src/core/*.vf})
    всё
    правило имя: {без-голого-malloc} тут
        запретить: [malloc, realloc, free]
        разрешить: [распределитель]
    всё
всё
