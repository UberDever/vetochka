;; условия с помеченными альтернативами, циклы с досрочным выходом
функция классифицировать: [ч :: цел32] результат: строка тут
    если(ч < 0) тут
        {отрицательное}
    всё иначе_если: (ч == 0) тут
        {ноль}
    всё иначе_если: (ч < 10) тут
        {малое}
    всё иначе: тут
        {большое}
    всё
всё

функция найти_первый: [элементы :: срез(цел32), цель :: цел32] результат: цел_разм тут
    и := 0
    пока(и < длина(элементы)) тут
        если(элементы[и] == цель) тут
            вернуть(и)
        всё
        если(элементы[и] < 0) тут
            и += 1
            продолжить()
        всё
        и += 1
    всё
    -1
всё

функция знак: [х :: цел32] результат: цел32 тут
    если(х > 0) тут 1 всё иначе: тут -1 всё
всё
