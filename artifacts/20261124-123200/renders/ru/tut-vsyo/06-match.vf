;; vsystem: размеченные объединения и сопоставление
объединение Фигура: [] тут
    круг: [радиус :: вещ64]
    прямоугольник: [ширина :: вещ64, высота :: вещ64]
    пусто: []
всё

функция площадь: [фигура :: Фигура] результат: вещ64 тут
    разобрать(фигура) тут
        случай круг: [р] тут
            вещ64{3.14159} * р * р
        всё
        случай прямоугольник: [ш, в] тут
            ш * в
        всё
        случай пусто: [] тут
            вещ64{0}
        всё
    всё
всё

функция описать: [фигура :: Фигура] результат: строка тут
    разобрать(фигура) тут
        случай круг: [р] тут формат({круг радиуса {}}, р) всё
        случай прямоугольник: [ш, в] тут формат({прямоугольник {} на {}}, ш, в) всё
        случай пусто: [] тут {ничего} всё
    всё
всё
