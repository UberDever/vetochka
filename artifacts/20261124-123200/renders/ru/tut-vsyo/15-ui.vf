;; дерево интерфейса: глубокая вложенность, маленькие встроенные блоки
окно заголовок: {Настройки} тут
    колонка отступ: 8 тут
        текст({Громкость})
        ползунок от: 0 до: 100 значение: громкость при_изменении: \[з] тут
            громкость = з
            сохранить(настройки)
        всё
        ряд тут
            кнопка({Отмена}) при_нажатии: тут закрыть(окно) всё
            кнопка({Готово}) при_нажатии: тут применить(настройки) ; закрыть(окно) всё
        всё
    всё
всё
