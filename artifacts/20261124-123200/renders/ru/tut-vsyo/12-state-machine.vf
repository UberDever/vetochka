;; конечный автомат с обработчиками событий
автомат(дверь) тут
    состояние(закрыта) тут
        при открыть: тут перейти(открывается) всё
        при запереть: тут перейти(заперта) всё
    всё
    состояние(открывается) тут
        вход: тут запустить_мотор() всё
        при готово: тут
            остановить_мотор()
            перейти(открыта)
        всё
    всё
    состояние(заперта) тут
        при отпереть: \[код] тут
            если(код == секрет) тут
                перейти(закрыта)
            всё иначе: тут
                тревога()
            всё
        всё
    всё
всё
