;; тестовый аппарат
набор{вектор} тут
    тест{добавление увеличивает вектор} тут
        в := создать(цел32, тестовый_распределитель)
        отложить тут освободить(цел32, в) всё
        ожидать(добавить(цел32, в, 7))
        ожидать(в[.длина] == 1)
    всё

    тест{получение проверяет границы} тут
        в := создать(цел32, тестовый_распределитель)
        отложить тут освободить(цел32, в) всё
        ожидать_ловушку(тут получить(цел32, в, 0) всё)
    всё
всё
