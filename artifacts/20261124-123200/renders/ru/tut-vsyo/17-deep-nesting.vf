;; проверка глубокой вложенности
транзакция(бд) тут
    для_каждой(записи) каждая: \[запись] тут
        если(годна(запись)) тут
            с_блокировкой(мьютекс) тут
                повторить(3) тут
                    если(существует(запись)) тут
                        обновить(запись)
                    всё иначе: тут
                        вставить(запись)
                    всё
                всё
            всё
        всё
    всё
всё
