;; декларативные данные: структуры, перечисления, конфигурация
структура Частица: [] do
    положение :: век3
    скорость :: век3
    время_жизни :: вещ32
end

перечисление Уровень: [] do
    отладка
    сведения
    предупреждение
    ошибка
end

настройки имя: сервер do
    адрес: {0.0.0.0}
    порт: 8080
    tls: [сертификат: {server.pem}, ключ: {server.key}]
    пределы do
        соединения: 1024
        байты_тела: 1048576
    end
end
