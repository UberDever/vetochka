;; ядро v0: case-лямбды по формам деревьев; разделителей блоков нет вовсе
размер = \[сам, ~[левое, правое]]
    ?[{:all}, {:fork}] сам(сам, левое) + сам(сам, правое) + 1
    ?[{:all}, {:fruit}] 1
    ?[{:all}, {:leaf}] 0

первый = \[~[голова, хвост]]
    ?[{:fork}] голова
    ?[{:all}] ~

количество = =[измерить = \[дерево] размер(размер, дерево)] измерить(~[~[~, ~], ~])
