;; условия с помеченными альтернативами, циклы с досрочным выходом
функция классифицировать: [ч :: цел32] результат: строка do
    если(ч < 0) do
        {отрицательное}
    end иначе_если: (ч == 0) do
        {ноль}
    end иначе_если: (ч < 10) do
        {малое}
    end иначе: do
        {большое}
    end
end

функция найти_первый: [элементы :: срез(цел32), цель :: цел32] результат: цел_разм do
    и := 0
    пока(и < длина(элементы)) do
        если(элементы[и] == цель) do
            вернуть(и)
        end
        если(элементы[и] < 0) do
            и += 1
            продолжить()
        end
        и += 1
    end
    -1
end

функция знак: [х :: цел32] результат: цел32 do
    если(х > 0) do 1 end иначе: do -1 end
end
