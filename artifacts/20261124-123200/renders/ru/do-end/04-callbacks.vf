;; обратные вызовы: блоки внутри вызовов заканчиваются на `;;)`
функция собрать_большие: [числа :: список(цел32)] результат: список(цел32) do
    итог := []
    для_каждого(числа, \[х] do
        если(х > 10) do
            дописать(итог, х)
        end
    end)
    итог
end

при(кнопка, {нажатие}, \[событие] do
    записать({нажато в}, событие[.х], событие[.у])
    обновить(вид)
end)

с_повтором(3, \[попытка] do
    подключиться(сервер) при_ошибке: \[ошибка] do
        записать({попытка не удалась}, попытка, ошибка)
    end
end)

таймер = каждые(секунды(5), \[тик] do опросить(очередь) end)
