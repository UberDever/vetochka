;; конечный автомат с обработчиками событий
автомат(дверь) do
    состояние(закрыта) do
        при открыть: do перейти(открывается) end
        при запереть: do перейти(заперта) end
    end
    состояние(открывается) do
        вход: do запустить_мотор() end
        при готово: do
            остановить_мотор()
            перейти(открыта)
        end
    end
    состояние(заперта) do
        при отпереть: \[код] do
            если(код == секрет) do
                перейти(закрыта)
            end иначе: do
                тревога()
            end
        end
    end
end
