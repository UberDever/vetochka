;; дерево интерфейса: глубокая вложенность, маленькие встроенные блоки
окно заголовок: {Настройки} do
    колонка отступ: 8 do
        текст({Громкость})
        ползунок от: 0 до: 100 значение: громкость при_изменении: \[з] do
            громкость = з
            сохранить(настройки)
        end
        ряд do
            кнопка({Отмена}) при_нажатии: do закрыть(окно) end
            кнопка({Готово}) при_нажатии: do применить(настройки) ; закрыть(окно) end
        end
    end
end
