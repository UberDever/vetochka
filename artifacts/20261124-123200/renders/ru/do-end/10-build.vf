;; описание сборки: декларативная вложенность
сборка do
    цель имя: {приложение} вид: {исполняемый} do
        исходники: [{src/main.vf}, {src/net.vf}]
        оптимизация: {выпуск}
        зависит: [{ядро}, {сеть}]
    end
    цель имя: {ядро} вид: {библиотека} do
        исходники: шаблон({src/core/*.vf})
    end
    правило имя: {без-голого-malloc} do
        запретить: [malloc, realloc, free]
        разрешить: [распределитель]
    end
end
