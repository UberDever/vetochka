;; vsystem: размеченные объединения и сопоставление
объединение Фигура: [] do
    круг: [радиус :: вещ64]
    прямоугольник: [ширина :: вещ64, высота :: вещ64]
    пусто: []
end

функция площадь: [фигура :: Фигура] результат: вещ64 do
    разобрать(фигура) do
        случай круг: [р] do
            вещ64{3.14159} * р * р
        end
        случай прямоугольник: [ш, в] do
            ш * в
        end
        случай пусто: [] do
            вещ64{0}
        end
    end
end

функция описать: [фигура :: Фигура] результат: строка do
    разобрать(фигура) do
        случай круг: [р] do формат({круг радиуса {}}, р) end
        случай прямоугольник: [ш, в] do формат({прямоугольник {} на {}}, ш, в) end
        случай пусто: [] do {ничего} end
    end
end
