;; тестовый аппарат
набор{вектор} do
    тест{добавление увеличивает вектор} do
        в := создать(цел32, тестовый_распределитель)
        отложить do освободить(цел32, в) end
        ожидать(добавить(цел32, в, 7))
        ожидать(в[.длина] == 1)
    end

    тест{получение проверяет границы} do
        в := создать(цел32, тестовый_распределитель)
        отложить do освободить(цел32, в) end
        ожидать_ловушку(do получить(цел32, в, 0) end)
    end
end
