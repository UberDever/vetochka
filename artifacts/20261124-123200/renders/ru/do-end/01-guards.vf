;; vsystem: растущий вектор; проверки с ранним возвратом
функция зарезервировать: [Т, в :: указ(Вектор(Т)), нужно :: разм] результат: лог do
    если(нужно <= в[.ёмкость]) do
        вернуть(истина)
    end
    новая_ёмкость := макс(нужно, макс(в[.ёмкость] * 2, 8))
    новые_данные := пам[.выделить_массив](в[.распределитель], Т, новая_ёмкость)
    если(новые_данные == пусто) do
        вернуть(ложь)
    end
    если(в[.данные] != пусто) do
        пам[.копировать](новые_данные, в[.данные], в[.длина])
        пам[.освободить](в[.распределитель], в[.данные])
    end
    в[.данные] = новые_данные
    в[.ёмкость] = новая_ёмкость
    истина
end

функция добавить: [Т, в :: указ(Вектор(Т)), значение :: Т] результат: лог do
    если(в[.длина] == в[.ёмкость]) do
        если(!зарезервировать(Т, в, в[.длина] + 1)) do
            вернуть(ложь)
        end
    end
    в[.данные][в[.длина]] = значение
    в[.длина] += 1
    истина
end
