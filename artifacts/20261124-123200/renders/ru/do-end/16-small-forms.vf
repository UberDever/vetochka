;; малые формы: пустые, однострочные, в списках и в скобках; комментарии
ничего do end
при_старте do начать() end
обработчики = [do записать({а}) end, do записать({б}) end]
отложенное = (do убрать() end)
пары = [первое: do а() end, второе: do б() end]
х = 1 ;; комментарий в конце строки
если(готово) do #| зачем |# пуск() end
элементы = [1, #;старое(2) 3]
длинный_вызов(альфа, бета) ...
    с: параметры do выполнить() end
функция сложить: [а :: цел32, б :: цел32] результат: цел32 do а + б end
