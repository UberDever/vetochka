;; параллелизм: акторы и циклы сообщений
счётчик = запустить do
    счёт := 0
    цикл do
        принять(сообщение) do
            случай увеличить: [] do счёт += 1 end
            случай получить: [ответить] do
                отправить(ответить, счёт)
            end
            случай стоп: [] do
                прервать()
            end
        end
    end
end

параллельно(задачи) каждая: \[задача] do
    итог := выполнить(задача)
    отправить(сборщик, итог)
end
