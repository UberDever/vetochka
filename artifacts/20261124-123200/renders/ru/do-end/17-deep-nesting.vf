;; проверка глубокой вложенности
транзакция(бд) do
    для_каждой(записи) каждая: \[запись] do
        если(годна(запись)) do
            с_блокировкой(мьютекс) do
                повторить(3) do
                    если(существует(запись)) do
                        обновить(запись)
                    end иначе: do
                        вставить(запись)
                    end
                end
            end
        end
    end
end
