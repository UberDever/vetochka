;; resources and errors: defer, errdefer, try
fn read_all: [path :: str] ret: !bytes do
    file := try(open(path))
    defer do
        close(file)
    end
    size := try(file_size(file))
    buffer := try(allocate(size))
    errdefer do
        free(buffer)
    end
    try(read_exact(file, buffer))
    ok(buffer)
end

fn copy_file: [from :: str, to :: str] ret: !unit do
    source := try(open(from))
    defer do close(source) end
    target := try(create(to))
    defer do close(target) end
    try(copy(source, target))
end
