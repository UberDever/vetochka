;; concurrency: actors and message loops
counter = spawn do
    count := 0
    loop do
        receive(message) do
            case increment: [] do count += 1 end
            case get: [reply_to] do
                send(reply_to, count)
            end
            case stop: [] do
                break()
            end
        end
    end
end

parallel(tasks) each: \[task] do
    result := run(task)
    send(collector, result)
end
