;; 深层嵌套压力测试
事务(库) do
    逐条(记录集) 每条: \[记录] do
        如果(有效(记录)) do
            加锁(互斥量) do
                重试(3) do
                    如果(存在(记录)) do
                        更新(记录)
                    end 否则: do
                        插入(记录)
                    end
                end
            end
        end
    end
end
