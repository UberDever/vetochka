;; 回调：调用里的块以 `;;)` 结尾
函数 收集大数: [列 :: 列表(整32)] 结果: 列表(整32) do
    结果集 := []
    逐个(列, \[元] do
        如果(元 > 10) do
            追加(结果集, 元)
        end
    end)
    结果集
end

监听(按钮, {点击}, \[事件] do
    记录({点击位置}, 事件[.横], 事件[.纵])
    刷新(视图)
end)

重试(3, \[次] do
    连接(服务器) 出错时: \[错误] do
        记录({尝试失败}, 次, 错误)
    end
end)

定时器 = 每隔(秒(5), \[刻] do 轮询(队列) end)
