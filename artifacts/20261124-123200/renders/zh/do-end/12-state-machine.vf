;; 带事件处理的状态机
状态机(门) do
    状态(关着) do
        当 打开: do 转到(开启中) end
        当 上锁: do 转到(锁着) end
    end
    状态(开启中) do
        进入: do 启动电机() end
        当 完成: do
            停止电机()
            转到(开着)
        end
    end
    状态(锁着) do
        当 解锁: \[密码] do
            如果(密码 == 秘密) do
                转到(关着)
            end 否则: do
                报警()
            end
        end
    end
end
