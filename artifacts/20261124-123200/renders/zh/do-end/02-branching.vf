;; 带标签分支的条件，可提前退出的循环
函数 分类: [数 :: 整32] 结果: 字串 do
    如果(数 < 0) do
        {负数}
    end 否则如果: (数 == 0) do
        {零}
    end 否则如果: (数 < 10) do
        {小}
    end 否则: do
        {大}
    end
end

函数 查找首个: [元素 :: 切片(整32), 目标 :: 整32] 结果: 整长 do
    序 := 0
    当(序 < 长度(元素)) do
        如果(元素[序] == 目标) do
            返回(序)
        end
        如果(元素[序] < 0) do
            序 += 1
            继续()
        end
        序 += 1
    end
    -1
end

函数 符号: [数 :: 整32] 结果: 整32 do
    如果(数 > 0) do 1 end 否则: do -1 end
end
