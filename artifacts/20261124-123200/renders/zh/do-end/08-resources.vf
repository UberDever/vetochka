;; 资源与错误：延后、出错延后、尝试
函数 读取全部: [路径 :: 字串] 结果: !字节 do
    文件 := 尝试(打开(路径))
    延后 do
        关闭(文件)
    end
    大小 := 尝试(文件大小(文件))
    缓冲 := 尝试(分配(大小))
    出错延后 do
        释放(缓冲)
    end
    尝试(精确读取(文件, 缓冲))
    成功(缓冲)
end

函数 复制文件: [源路径 :: 字串, 目标路径 :: 字串] 结果: !无 do
    源 := 尝试(打开(源路径))
    延后 do 关闭(源) end
    目标 := 尝试(创建(目标路径))
    延后 do 关闭(目标) end
    尝试(复制(源, 目标))
end
