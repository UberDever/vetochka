;; 并发：actor 与消息循环
计数器 = 派生 do
    计数 := 0
    循环 do
        接收(消息) do
            情况 增加: [] do 计数 += 1 end
            情况 获取: [回复给] do
                发送(回复给, 计数)
            end
            情况 停止: [] do
                跳出()
            end
        end
    end
end

并行(任务) 每个: \[任务] do
    结果 := 运行(任务)
    发送(收集器, 结果)
end
