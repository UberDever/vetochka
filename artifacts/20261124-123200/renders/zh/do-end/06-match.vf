;; vsystem：带标签的联合与模式匹配
联合 形状: [] do
    圆: [半径 :: 浮64]
    矩形: [宽 :: 浮64, 高 :: 浮64]
    空: []
end

函数 面积: [形 :: 形状] 结果: 浮64 do
    匹配(形) do
        情况 圆: [半] do
            浮64{3.14159} * 半 * 半
        end
        情况 矩形: [宽, 高] do
            宽 * 高
        end
        情况 空: [] do
            浮64{0}
        end
    end
end

函数 描述: [形 :: 形状] 结果: 字串 do
    匹配(形) do
        情况 圆: [半] do 格式({半径为 {} 的圆}, 半) end
        情况 矩形: [宽, 高] do 格式({{} 乘 {} 的矩形}, 宽, 高) end
        情况 空: [] do {无} end
    end
end
