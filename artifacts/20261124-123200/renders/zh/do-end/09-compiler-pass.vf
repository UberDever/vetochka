;; vmeta：编译遍就是作用于项的函数
名字 = \[自身, ~[头, 尾], 已收集]
    ?[{:all}, {:fork}, {:all}] 自身(自身, 尾, 自身(自身, 头, 已收集))
    ?[{:all}, {:fruit}, {:all}] 已收集
    ?[{:all}, {:leaf}, {:all}] 已收集

编译遍 名称: 收集函数名 作用于: 模块 do
    已找到 := []
    遍历(模块) 对每个: \[节点] do
        如果(是函数(节点)) do
            推入(已找到, 节点[.名称])
        end
    end
    已找到
end

编译遍 名称: 禁止malloc 作用于: 模块 do
    遍历(模块) 对每个: \[节点] do
        如果(是调用(节点, {malloc})) do
            报告(节点, {请使用分配器参数})
        end
    end
end
