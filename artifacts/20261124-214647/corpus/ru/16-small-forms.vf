# малые формы: пустые, однострочные, в списках и в скобках; комментарии
ничего : ;;
при_старте : начать() ;;
обработчики = [: записать({а}) ;;, : записать({б}) ;;]
отложенное = (: убрать() ;;)
пары = [~первое: а() ;;, ~второе: б() ;;]
х = 1 # комментарий в конце строки
если(готово): #| зачем |# пуск() ;;
элементы = [1, #;старое(2) 3]
длинный_вызов(альфа, бета) ...
    ~с(параметры): выполнить() ;;
функция ~сложить[а :: цел32, б :: цел32] ~результат(цел32): а + б ;;
