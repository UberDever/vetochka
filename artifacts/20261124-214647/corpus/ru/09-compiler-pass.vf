# vmeta: проходы над термами; форма со строками — код v0 со своим смыслом
имена = \[сам, ~[голова, хвост], собранное]
    ?[~all, ~fork, ~all] сам(сам, хвост, сам(сам, голова, собранное))
    ?[~all, ~fruit, ~all] собранное
    ?[~all, ~leaf, ~all] собранное

проход ~собрать_имена_функций ~над(модуль):
    найдено := []
    обойти(модуль) ~узел:
        если(это_функция(узел)):
            добавить(найдено, узел[.имя])
        ;;
    ;;
    найдено
;;

проход ~запретить_malloc ~над(модуль):
    обойти(модуль) ~узел:
        если(это_вызов(узел, ~malloc)):
            сообщить(узел, {используйте параметр-распределитель})
        ;;
    ;;
;;
