# функциональный стиль в vf: блоки с именем-символом, а не лямбды v0
квадраты = отобразить(числа) ~х: х * х ;;
чётные = отобрать(числа) ~х: х % 2 == 0 ;;
сумма = свернуть(числа, 0) ~итог ~х: итог + х ;;

функция ~композиция[ф, г] ~результат(функция):
    функция ~составная[х]: ф(г(х)) ;;
;;

функция ~среднее[числа :: список(вещ64)] ~результат(вещ64):
    всего := свернуть(числа, вещ64{0}) ~а ~б: а + б ;;
    всего / длина(числа)
;;

разобранные = отобразить(строки) ~строка: разобрать_число(строка) ;;
годные = отобрать(разобранные) ~ч: ч >= 0 ;;
умноженные = отобразить(годные) ~ч: ч * 10 ;;
итог = свернуть(умноженные, 0) ~а ~б: а + б ;;
