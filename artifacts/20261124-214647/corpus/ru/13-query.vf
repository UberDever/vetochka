# аппарат запросов: предложения — символы с блоками
отчёт = из(заказы) ~з ...
    ~где: з[.сумма] > 100 ;; ...
    ~группа: з[.клиент] ;; ...
    ~выбрать: [~клиент(з[.клиент]), ~потрачено(сумма(з[.сумма]))] ;;

проверка = из(события) ~с ~где:
    с[.вид] == ~вход
    с[.неудачно]
;; ~порядок: с[.время] ;; ~предел(50)
