# ресурсы и ошибки: отложить, отложить_при_ошибке, попробовать
функция ~прочитать_всё[путь :: строка] ~результат(!байты):
    файл := попробовать(открыть(путь))
    отложить :
        закрыть(файл)
    ;;
    размер := попробовать(размер_файла(файл))
    буфер := попробовать(выделить(размер))
    отложить_при_ошибке :
        освободить(буфер)
    ;;
    попробовать(прочитать_точно(файл, буфер))
    успех(буфер)
;;

функция ~копировать_файл[откуда :: строка, куда :: строка] ~результат(!ничто):
    источник := попробовать(открыть(откуда))
    отложить : закрыть(источник) ;;
    приёмник := попробовать(создать(куда))
    отложить : закрыть(приёмник) ;;
    попробовать(копировать(источник, приёмник))
;;
