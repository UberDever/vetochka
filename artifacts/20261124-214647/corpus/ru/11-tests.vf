# тестовый аппарат
набор{вектор}:
    тест{добавление увеличивает вектор}:
        в := создать(цел32, тестовый_распределитель)
        отложить ~тут: освободить(цел32, в) ;;
        ожидать(добавить(цел32, в, 7))
        ожидать(в[.длина] == 1)
    ;;

    тест{получение проверяет границы}:
        в := создать(цел32, тестовый_распределитель)
        отложить ~тут: освободить(цел32, в) ;;
        ожидать_ловушку(: получить(цел32, в, 0) ;;)
    ;;
;;
