# конечный автомат с обработчиками событий
автомат(дверь):
    состояние(закрыта):
        при ~открыть: перейти(открывается) ;;
        при ~запереть: перейти(заперта) ;;
    ;;
    состояние(открывается):
        ~вход: запустить_мотор() ;;
        при ~готово:
            остановить_мотор()
            перейти(открыта)
        ;;
    ;;
    состояние(заперта):
        при ~отпереть ~код:
            если(код == секрет):
                перейти(закрыта)
            ;; ~иначе:
                тревога()
            ;;
        ;;
    ;;
;;
