# v0 core inside vf: case-lambdas keep their v0 meaning; row heads are symbols
size = \[self, ~[left, right]]
    ?[~all, ~fork] self(self, left) + self(self, right) + 1
    ?[~all, ~fruit] 1
    ?[~all, ~leaf] 0

first = \[~[head, rest]]
    ?[~fork] head
    ?[~all] ~

count = =[measure = \[tree] size(size, tree)] measure(~[~[~, ~], ~])
