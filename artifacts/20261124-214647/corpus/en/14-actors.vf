# concurrency: actors and message loops
counter = spawn ~do:
    count := 0
    loop ~do:
        receive(message):
            case ~increment[]: count += 1 ;;
            case ~get[reply_to]:
                send(reply_to, count)
            ;;
            case ~stop[]:
                break()
            ;;
        ;;
    ;;
;;

parallel(tasks) ~task:
    result := run(task)
    send(collector, result)
;;
