# vf 中的函数式风格：用符号命名的块，而不是 v0 lambda
平方 = 映射(列) ~元: 元 * 元 ;;
偶数 = 过滤(列) ~元: 元 % 2 == 0 ;;
总和 = 折叠(列, 0) ~累计 ~元: 累计 + 元 ;;

函数 ~组合[函, 另] ~结果(函数):
    函数 ~复合[元]: 函(另(元)) ;;
;;

函数 ~平均[列 :: 列表(浮64)] ~结果(浮64):
    和 := 折叠(列, 浮64{0}) ~甲 ~乙: 甲 + 乙 ;;
    和 / 长度(列)
;;

已解析 = 映射(各行) ~行: 解析整数(行) ;;
有效 = 过滤(已解析) ~数: 数 >= 0 ;;
放大 = 映射(有效) ~数: 数 * 10 ;;
合计 = 折叠(放大, 0) ~甲 ~乙: 甲 + 乙 ;;
