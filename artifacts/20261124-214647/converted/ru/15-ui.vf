# дерево интерфейса: глубокая вложенность, маленькие встроенные блоки
окно ~заголовок{Настройки}:
    колонка ~отступ(8):
        текст({Громкость})
        ползунок ~от(0) ~до(100) ~значение(громкость) ~при_изменении(\[з]:
            громкость = з
            сохранить(настройки)
        ;;)
        ряд :
            кнопка({Отмена}) ~при_нажатии: закрыть(окно) ;;
            кнопка({Готово}) ~при_нажатии: применить(настройки) ; закрыть(окно) ;;
        ;;
    ;;
;;
