# параллелизм: акторы и циклы сообщений
счётчик = запустить :
    счёт := 0
    цикл :
        принять(сообщение):
            случай ~увеличить[]: счёт += 1 ;;
            случай ~получить[ответить]:
                отправить(ответить, счёт)
            ;;
            случай ~стоп[]:
                прервать()
            ;;
        ;;
    ;;
;;

параллельно(задачи) ~каждая(\[задача]:
    итог := выполнить(задача)
    отправить(сборщик, итог)
;;)
