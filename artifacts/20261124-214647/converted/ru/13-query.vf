# аппарат запросов: предложения как метки с блоком или лямбдой
отчёт = из(заказы) ...
    ~где(\[з] з[.сумма] > 100) ...
    ~группа(\[з] з[.клиент]) ...
    ~выбрать(\[г] [~клиент(г[.ключ]), ~потрачено(сумма(г, \[з] з[.сумма]))])

проверка = из(события) ~где:
    вид == {вход}
    неудачно
