# декларативные данные: структуры, перечисления, конфигурация
структура ~Частица[]:
    положение :: век3
    скорость :: век3
    время_жизни :: вещ32
;;

перечисление ~Уровень[]:
    отладка
    сведения
    предупреждение
    ошибка
;;

настройки ~имя(сервер):
    ~адрес{0.0.0.0}
    ~порт(8080)
    ~tls[~сертификат{server.pem}, ~ключ{server.key}]
    пределы :
        ~соединения(1024)
        ~байты_тела(1048576)
    ;;
;;
